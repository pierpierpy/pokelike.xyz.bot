# Credentials for the LLM bot. Copy to .env and fill in your own.
# Works with any OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, ...).
#
#   cp .env.example .env && nano .env
#   set -a && source .env && set +a
#   uv run pokelike bot run --bot llm-baseline --runs 3
#
# This file is also what `docker compose -f llm-bench/docker/docker-compose.yml`
# reads, so a container run needs nothing else.
#
# You do not have to use it. The same three values exist as flags on `bot run`,
# `bot bench` and `model bench`, and they override whatever is exported:
#
#   uv run pokelike bot run --bot llm-baseline --endpoint https://... --api-key sk-...
#   uv run pokelike bot run --bot llm-baseline --api-key @~/.key --model m
#
# Prefer @path or this file for the key: a key written literally on a command line
# is readable by every other user of the machine in `ps`, and your shell saves it.

FW_ENDPOINT="https://your-endpoint"   # no trailing /v1
FW_TOKEN="your-key"
MODEL_ID="your-model-name"            # not needed if the bot pins MODEL itself
