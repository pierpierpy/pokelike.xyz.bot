.venv/
site/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
# Recordings of local play live in a database at the top level. Anchored with a
# leading slash: written as `stats/` this also matched src/pokelike/stats/, so a
# new file in that package would have been silently ignored.
/stats/

.env

# Generated on demand by `pokelike schema --markdown` from a live observation.
# Not committed: the docs point at `uv run pokelike schema` (stdout) instead, so
# the state reference cannot describe a game that no longer exists.
STATE.md

# working list, not documentation
TODO.md

# personal notes on how the pieces fit together, written to be reread, not
# published: it names the open holes in the benchmark before they are fixed.
ARCHITECTURE.md

# Source recordings. The GIFs beside them are what ships; a 200 MB mp4 is past
# GitHub's 100 MB file cap anyway. (gitignore has no trailing comments, so this
# note goes on its own line.)
img/*.mp4

# ---------------------------------------------------------------------------
# experiments/ is a scratch area. What you try there is YOURS: it does not
# belong in anyone else's clone, and a pull request that adds a bot should not
# drag a training run along with it.
#
# Tracked: the shared environment, and OUR experiments, which are there to be
# read as worked examples. Anything else you create is yours and is ignored.
experiments/*
!experiments/README.md
!experiments/AGENTS.md
!experiments/__init__.py
!experiments/env/
!experiments/example/
!experiments/dyna-q/
!experiments/llm/
!experiments/sarsa/
!experiments/drrn/

# ...and never what a run produces, for any of them. `artifacts/` is in the
# list because an experiment's bot.py is a CANDIDATE: its weights are training
# output, and they only become something to commit when the bot earns a folder
# under bots/ and is measured there.
experiments/*/output/
experiments/*/logs/
experiments/*/artifacts/

# Same rule for the model benchmark: the harness and the results are the record
# and are committed, the running commentary is not.
llm-bench/*/logs/
/home/pdipasquale/pokelike.xyz/TIPS_AND_TRICKS.md

# local research notes, never published
TIPS_AND_TRICKS.md
